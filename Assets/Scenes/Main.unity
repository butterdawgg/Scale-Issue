  m_Script: {fileID: 11500000, guid: c33952e69819f61448bf84371676b486, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  lines:
  - speaker: Mission Assistant
    text: WHAT THE HELL WAS THAT?!
    fastForwardKey: 102
    skipKey: 102
  - speaker: You
    text: I DON'T KNOW, CALM DOWN!
    fastForwardKey: 102
    skipKey: 102
  - speaker: Mission Assistant
    text: O-Okay, s-o-o, if I'm not mistaken this was a dog-sized bacteria.
    fastForwardKey: 102
    skipKey: 102
  - speaker: You
    text: Affirmative.
    fastForwardKey: 102
    skipKey: 102
  - speaker: Mission Assistant
    text: Actually... everything now makes sense! The evacuation, the "contamination"
      event...
    fastForwardKey: 102
    skipKey: 102
  - speaker: You
    text: Indeed.
    fastForwardKey: 102
    skipKey: 102
  - speaker: Mission Assistant
    text: We have to find out how they did that! Head to the lab, it should be straight
      ahead.
    fastForwardKey: 102
    skipKey: 102
  - speaker: You
    text: Understood.
    fastForwardKey: 102
    skipKey: 102
  isPlayed: 0
